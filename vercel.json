{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/leetcode",
      "destination": "/api/leetcode.js"
    },
    {
      "source": "/api/geeksforgeeks",
      "destination": "/api/geeksforgeeks.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
